# Copy this file to ".env" and put your real keys after the = signs.
# The .env file stays on your machine and is never uploaded anywhere.

# Required for Render mode (text-to-speech narration):
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Required for Author mode (generating lab markdown from code + notes).
# You only need the one for the provider you pick in the app.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
